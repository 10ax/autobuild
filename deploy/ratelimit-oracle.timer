# deploy/ratelimit-oracle.timer  ->  ~/.config/systemd/user/ratelimit-oracle.timer
# Keeps ~/.claude/usage-oracle.json fresh (< the 900s freshness window in usage.py) so the
# governor has a live status+reset even when idle/paused and no interactive session is open.
[Unit]
Description=Run the autobuild rate-limit oracle every ~7 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=7min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
