# deploy/ratelimit-oracle.service  ->  ~/.config/systemd/user/ratelimit-oracle.service
[Unit]
Description=Autobuild rate-limit oracle (writes ~/.claude/usage-oracle.json)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
# Same PATH as autobuild.service so `claude`, node, etc. resolve (update the nvm pin if it changes).
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.nvm/versions/node/v22.16.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash %h/autobuild/deploy/ratelimit-oracle.sh
NoNewPrivileges=yes
