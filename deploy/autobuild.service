# deploy/autobuild.service  ->  ~/.config/systemd/user/autobuild.service
[Unit]
Description=Autobuild runner (autonomous overnight builder)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/autobuild
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.nvm/versions/node/v22.16.0/bin:/usr/local/bin:/usr/bin:/bin
# GitHub identity for the daemon + all its build subprocesses: the isolated gh config (account
# 10ax, personal) and 10ax's commit authorship — leaves the user's separate interactive login alone.
Environment=GH_CONFIG_DIR=%h/.config/gh-autobuild
Environment=GIT_AUTHOR_NAME=10ax
Environment=GIT_AUTHOR_EMAIL=157908022+10ax@users.noreply.github.com
Environment=GIT_COMMITTER_NAME=10ax
Environment=GIT_COMMITTER_EMAIL=157908022+10ax@users.noreply.github.com
ExecStart=/usr/bin/python3 -m autobuild --poll 300
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=%h/autobuild %h/.claude %h/.claude.json %h/.npm %h/.cache %h/.config %h/.tokensave %h/.local/state

[Install]
WantedBy=default.target
