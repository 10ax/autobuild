.superpowers/
__pycache__/
*.pyc
# built projects (each has its own git repo) and runtime state are not part of the infra repo
projects/*
!projects/.gitkeep
state/*
!state/.gitkeep
# business content — kept local (daemon needs backlog/) but stripped from the public repo + history
docs/hustle/
staging-backlog/
backlog/*.md
docs/superpowers/specs/
